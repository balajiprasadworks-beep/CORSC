# Copy this file to .env.local for local development.
# Never commit a populated .env.local.
#
# Every value below is a placeholder. Take the real ones from the Supabase
# dashboard (Project Settings -> Database, and Project Settings -> API) or
# from the Vercel project's environment variables.

# ---------------------------------------------------------------- database

# Pooled connection used by the CORSC API. Transaction mode, port 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Unpooled connection used by `prisma migrate`. See docs/MIGRATION_RUNBOOK.md.
#
# This must NOT be the transaction pooler on 6543: it multiplexes statements
# across backends, so Prisma's session advisory lock and its DDL do not behave.
# Use either the session-mode pooler on port 5432 (shown here), or the direct
# host db.<project-ref>.supabase.co:5432 — note that the direct host resolves
# to IPv6 only unless the project has the IPv4 add-on, which is why the
# session pooler is usually the working choice.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- auth

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

# --------------------------------------------------------------- optional

# Turns a skipped database-backed test into a failure. Set in CI, where the
# database suites are a release gate and must not pass by simply being absent.
# CORSC_REQUIRE_DB=1

# Enables the AI note tools (paste-note extraction, AI-drafted visit notes).
# Both features are explicit clinician actions that send text to OpenAI; they
# stay absent from the UI's error messages as "not configured" without this.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5"

# CORSC_INGREDIENTS_CSV="ingredients 2.0.csv"
# CORSC_PRODUCTS_CSV="products 2.0.csv"
