+    </div>
+    <div className="grid grid-cols-3 gap-2 mt-1">
+      {[['BMI', bmi && bmi.toFixed(1)], ['BSA', bsa && bsa.toFixed(2) + ' m²'], ['Weight loss', loss != null ? loss.toFixed(1) + '%' : '—']].map(([label, value]) => <div key={label} className="rounded-xl bg-slate-50 border border-slate-200 p-3"><div className="text-[10px] uppercase tracking-wider text-slate-400">{label}</div><div className="font-bold text-slate-900 mt-1">{value || '—'}</div></div>)}
